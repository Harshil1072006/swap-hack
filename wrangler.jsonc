{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "swap-hack",
	"main": "src/worker.js",
	"compatibility_date": "2026-06-15",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "swap-hack",
			"database_id": "020a3c87-9c29-4ba6-8e97-9524cdbbedec",
			"migrations_dir": "migrations"
		}
	],
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	}
}