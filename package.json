{
  "devDependencies": {
    "wrangler": "4.166.0"
  },
  "name": "swap-hack",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "migrate": "wrangler d1 migrations apply DB --local",
    "deploy": "wrangler deploy",
    "build:locales": "node scripts/locales.mjs",
    "test": "node scripts/test.mjs",
    "check": "find src public scripts -name '*.js' -o -name '*.mjs' | xargs -r -n 1 node --check"
  }
}
